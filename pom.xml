        <!-- https://mvnrepository.com/artifact/net.jcip/jcip-annotations -->
<!--        <dependency>-->
<!--            <groupId>net.jcip</groupId>-->
<!--            <artifactId>jcip-annotations</artifactId>-->
<!--            <version>1.0</version>-->
<!--            <scope>provided</scope>-->
